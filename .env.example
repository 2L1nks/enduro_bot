# ============================================================
#  Скопируйте этот файл в .env и заполните значения.
#  Подробно о каждой строке — README.md, раздел 5.
#  Что менять для боевого сервера, отмечено комментарием ПРОД.
# ============================================================

# ---- Telegram ----
BOT_TOKEN=123456:AA-replace-me
# Ваш Telegram ID (узнать: напишите @userinfobot).
# Этот аккаунт станет владельцем и получит доступ к админке.
OWNER_TG_ID=0

# ---- База данных ----
# localhost — PostgreSQL на этом же компьютере (Windows или Linux без Docker).
# В Docker адрес подставляется сам, менять не нужно.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enduro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=пароль-который-задали-при-установке

# ---- FSM: где хранить незаконченные формы ----
# memory — ничего ставить не надо, но при перезапуске бота
#          наполовину заполненная форма админа потеряется.
# redis  — переживает перезапуск. ПРОД: redis
FSM_STORAGE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Хранилище фото ----
# yadisk — папка клиента на Яндекс.Диске. ПРОД: yadisk
# local  — папка storage\ рядом с проектом. Для разработки хватает.
# s3     — MinIO или Yandex Object Storage.
STORAGE_BACKEND=local

# Токен Яндекс.Диска (нужен при STORAGE_BACKEND=yadisk).
# Получить: https://yandex.ru/dev/disk/poligon/ — доступ на запись.
YANDEX_DISK_TOKEN=
# Корневая папка на Диске, внутри неё заводятся папки клиентов
YANDEX_DISK_ROOT=enduro
LOCAL_STORAGE_PATH=storage

# Нужны только при STORAGE_BACKEND=s3
# Yandex: S3_ENDPOINT=https://storage.yandexcloud.net, S3_REGION=ru-central1
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=enduro-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Бизнес-правила ----
# Буфер между выездами на осмотр и заправку, минуты
BOOKING_BUFFER_MINUTES=30
# Максимум участников в одном выезде
MAX_GROUP_SIZE=8
# Единое место сбора — попадает в подтверждение и напоминания
MEETING_POINT=Москва, Пушкино, база «Эндуро»
# Единая цена за одного участника, рублей
PRICE_PER_PERSON=5000

# Варианты длительности аренды в минутах (кнопки при записи).
# 60,90,120,180 = 1 ч / 1,5 ч / 2 ч / 3 ч. Произвольное время
# клиент может ввести отдельной кнопкой.
RENTAL_DURATIONS=60,90,120,180
# Шаг сетки времени в календаре, минуты
SLOT_STEP_MINUTES=30
# Рабочие часы проката
WORKDAY_START=09:00
WORKDAY_END=20:00
TIMEZONE=Europe/Moscow

# ---- Прочее ----
LOG_LEVEL=INFO
